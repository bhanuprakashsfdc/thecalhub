# TheCalHub — environment variables (all optional; the site builds and runs with none of them set)

# VITE_ADSENSE_CLIENT: your real AdSense publisher ID, prefixed with ca-pub-.
# Issued by Google AdSense after account creation (Account > Settings > Account information).
# Leave unset while the site is not yet monetized: no AdSense script is loaded,
# AdSlot renders nothing, and no ad requests are made.
# IMPORTANT: the value must also be copied into public/ads.txt (without the "ca-" prefix).
VITE_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"

# VITE_GA_ID: your real Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Leave unset to disable Google Analytics entirely (no gtag script is injected).
VITE_GA_ID=""

# VITE_OG_IMAGE: optional absolute URL of the social share image (1200x632 PNG/JPG).
# When empty/unset, PageSEO falls back to /icon-512.svg. SVG is not rendered by
# Facebook/Twitter/LinkedIn, so set a PNG before launch (see docs/ADSENSE_CHECKLIST.md).
VITE_OG_IMAGE=""
